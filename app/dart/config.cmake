# Application parameters are owned by params.json; hardware still uses the
# template's IOC/board/robot generators. This file only emits dart constants.
string(JSON PNX_DART_ENABLED ERROR_VARIABLE dart_error GET "${params_json}" dart enabled)
if(dart_error)
    set(PNX_DART_ENABLED OFF)
endif()
if(NOT PNX_DART_ENABLED)
    return()
endif()
if(NOT ENABLE_USBX OR NOT ENABLE_DR16)
    message(FATAL_ERROR "The migrated dart application requires build.usbx=true and remoter.source=dr16")
endif()

set(dart_header "#pragma once\n// Generated from params.json and robot.json. Do not edit.\n#include <cstdint>\n#include \"configuration.hpp\"\nnamespace dart::cfg {\n")
function(dart_fields section type)
    string(APPEND dart_header "namespace ${section} {\n")
    foreach(field IN LISTS ARGN)
        string(JSON value ERROR_VARIABLE error GET "${params_json}" dart ${section} ${field})
        if(error)
            message(FATAL_ERROR "dart.${section}.${field} is required")
        endif()
        if(type STREQUAL "bool")
            if(value)
                set(value "true")
            else()
                set(value "false")
            endif()
        elseif(NOT value MATCHES "^-?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$")
            message(FATAL_ERROR "dart.${section}.${field} must be numeric")
        elseif(type STREQUAL "float")
            if(NOT value MATCHES "[.eE]")
                string(APPEND value ".0")
            endif()
            string(APPEND value "f")
        elseif(type STREQUAL "std::uint32_t" AND NOT value MATCHES "^[0-9]+$")
            message(FATAL_ERROR "dart.${section}.${field} must be a nonnegative integer")
        endif()
        string(APPEND dart_header "inline constexpr ${type} ${field} = ${value};\n")
        if(field MATCHES "(_ticks|_priority)$" AND type STREQUAL "std::uint32_t")
            if(value LESS 1 OR (field MATCHES "_priority$" AND value GREATER 31))
                message(FATAL_ERROR "dart.${section}.${field} is outside the ThreadX range")
            endif()
        endif()
    endforeach()
    string(APPEND dart_header "}\n")
    set(dart_header "${dart_header}" PARENT_SCOPE)
endfunction()

