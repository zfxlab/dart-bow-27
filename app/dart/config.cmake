# Protocol addresses/direction are device composition, not BSP policy.
string(APPEND dart_header "namespace motor {\n")
string(JSON motor_count LENGTH "${robot_json}" devices motors list)
math(EXPR motor_last "${motor_count} - 1")
foreach(index RANGE ${motor_last})
    string(JSON motor_name GET "${robot_json}" devices motors list ${index} name)
    if(motor_name STREQUAL "string_l" OR motor_name STREQUAL "string_r")
        string(JSON direction GET "${robot_json}" devices motors list ${index} positive_dir)
        if(NOT direction MATCHES "^[01]$")
            message(FATAL_ERROR "${motor_name}.positive_dir must be 0 or 1")
        endif()
        string(APPEND dart_header "inline constexpr std::uint8_t ${motor_name}_positive_dir = ${direction};\n")
    endif()
endforeach()
string(APPEND dart_header "}\ninline constexpr dart_param calibration[] = {\n")
string(JSON count LENGTH "${params_json}" dart calibration)
if(NOT count EQUAL 16)
    message(FATAL_ERROR "dart.calibration requires 16 entries in dart ID order")
endif()
foreach(index RANGE 0 15)
    math(EXPR id "${index} + 1")
    string(APPEND dart_header "{${id}, ")
    foreach(field IN ITEMS yaw_offset tension_kg_base tension_kg_outpost)
        string(JSON value GET "${params_json}" dart calibration ${index} ${field})
        string(APPEND dart_header "static_cast<float>(${value}), ")
    endforeach()
    string(APPEND dart_header "},\n")
endforeach()
string(APPEND dart_header "};\ninline constexpr table_point distance_table[] = {\n")
string(JSON count LENGTH "${params_json}" dart distance_table)
if(count LESS 1 OR count GREATER 128)
    message(FATAL_ERROR "dart.distance_table requires 1..128 entries")
endif()
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
    string(JSON id GET "${params_json}" dart distance_table ${index} id)
    string(APPEND dart_header "{${id}, ")
    foreach(field IN ITEMS distance yaw_offset tension_kg)
        string(JSON value GET "${params_json}" dart distance_table ${index} ${field})
        string(APPEND dart_header "static_cast<float>(${value}), ")
    endforeach()
    string(APPEND dart_header "},\n")
endforeach()
string(APPEND dart_header "};\ninline constexpr int sequence[4] = {")
string(JSON count LENGTH "${params_json}" dart sequence)
if(NOT count EQUAL 4)
    message(FATAL_ERROR "dart.sequence requires four dart IDs")
endif()
foreach(index RANGE 0 3)
    string(JSON id GET "${params_json}" dart sequence ${index})
    if(id LESS 1 OR id GREATER 16)
        message(FATAL_ERROR "dart.sequence ID must be in 1..16")
    endif()
    string(APPEND dart_header "${id}, ")
endforeach()
string(JSON pre_tension GET "${params_json}" dart pre_tension_kg)
string(APPEND dart_header "};\ninline constexpr float pre_tension_kg = static_cast<float>(${pre_tension});\n}\n")
file(CONFIGURE OUTPUT "${PNX_EMBEDDED_GENERATED_DIR}/dart_config.hpp" CONTENT "${dart_header}" @ONLY)
