{
  "name": "h723_mc02",
  "mcu_family": "stm32h7",
  "memory": {
    "dma_policy": "dedicated_section",
    "cache_line_size": 32,
    "dma_accessible_ranges": [
      {
        "start": "0x24000000",
        "end": "0x24050000"
      },
      {
        "start": "0x30000000",
        "end": "0x30008000"
      }
    ]
  },
  "bindings": {
    "gpio_inputs": {
      "bmi088_gyro_drdy": {
        "pin": "pe12",
        "active_level": "high"
      }
    },
    "gpio_outputs": {
      "bmi088_acc_cs": {
        "pin": "pc0",
        "active_level": "low"
      },
      "bmi088_gyro_cs": {
        "pin": "pc3",
        "active_level": "low"
      }
    },
    "pwm_channels": {
      "bmi088_heater": {
        "timer": "tim3",
        "channel": 4,
        "failsafe_timer": "tim6"
      }
    }
  },
  "devices": {
    "bmi088": {
      "spi": "spi2",
      "acc_cs": "bmi088_acc_cs",
      "gyro_cs": "bmi088_gyro_cs",
      "gyro_drdy": "bmi088_gyro_drdy",
      "heater_pwm": "bmi088_heater"
    },
    "led": {
      "spi": "spi6"
    }
  }
}
